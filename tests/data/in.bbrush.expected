######################
#   Initialization   #
######################

units lj
atom_style bond
special_bonds fene
boundary p p p

#######################
#   Atom definition   #
#######################


read_data bbrush.dat
create_atoms 3 random 40 9592497 NULL
create_atoms 4 random 40 9336433 NULL

################
#   Settings   #
################

neighbor 0.8 bin
neigh_modify check yes

pair_style lj/cut 1.1224
pair_coeff 1 1 1.0 1.0
pair_coeff 1 2 1.0 1.0
pair_coeff 2 2 1.0 1.0
pair_coeff 1 3 0.1 7.5 18.75
pair_coeff 2 3 0.1 7.5 18.75
pair_coeff 1 4 0.1 5.5 13.75
pair_coeff 2 4 0.1 5.5 13.75
pair_coeff 3 3 1.0 14.0 15.714468676331222
pair_coeff 3 4 1.0 12.0 13.469544579712476
pair_coeff 4 4 1.0 10.0 11.22462048309373

bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0

minimize 1e-5 1e-5 1000 1000
reset_timestep 0

fix 1 all nvt temp 1.0 1.0 1.0

#####################
#   Calculations    #
#####################

group bbone id 1:99
compute gyrb bbone gyration
fix gyration bbone ave/time 1000 50 500000 c_gyrb file gyration/gyr_bbone_0.txt start 500000

group bbrush type 1 2

compute gyr bbrush gyration
fix gyration1 bbrush ave/time 1000 50 500000 c_gyr file gyration/gyr_all_0.txt start 500000

group bbone_extremes id 1 99

###########
# Dumping #
###########

restart 250000 bbrush.restart bbrush2.restart

dump config all custom 500000 configurations/bbrush_0.lammpstrj id type x y z

dump endtoend bbone_extremes xyz 500000 gyration/bbone_extremes_0.lammpstrj

##########################
#   Running simulation   #
##########################

timestep 0.001
thermo 500000
thermo_style custom step temp etotal ke pe epair emol press vol
thermo_modify flush yes
run 1000000000
