######################
#   Initialization   #
######################

units lj
atom_style bond
special_bonds fene
boundary p p p

#######################
#   Atom definition   #
#######################


read_restart star2.restart remap

################
#   Settings   #
################

neighbor 0.8 bin
neigh_modify check yes

pair_style hybrid lj/cut 1.122462048309373 lj/sf 1.122462048309373
pair_coeff 1 1 lj/sf 1.0 1.0 1.122462048309373
pair_coeff 1 2 lj/sf 1.0 2.25 2.5255396086960893
pair_coeff 2 2 lj/sf 1.0 3.5 3.9286171690828056
pair_coeff 1 3 lj/cut 0.2 5.770758378941567 14.426895947353916
pair_coeff 2 3 lj/cut 0.2 7.020758378941567 17.551895947353916
pair_coeff 3 3 lj/sf 1.0 10.541516757883134 11.832452492341083

bond_style fene
bond_coeff 1 30.0 1.5 1 1.0
bond_coeff 2 5.925925925925926 3.375 1 2.25

minimize 1e-5 1e-5 1000 1000
reset_timestep 0

fix 1 all nvt temp 1.0 1.0 1.0

#####################
#   Calculations    #
#####################

group star type 1 2

compute gyr star gyration
fix gyration1 star ave/time 1000 50 500000 c_gyr file gyration/gyr_all_1.txt start 500000

###########
# Dumping #
###########

restart 100000 star.restart star2.restart

dump config all custom 500000 configurations/star_1.lammpstrj id type x y z

##########################
#   Running simulation   #
##########################

timestep 0.01
thermo 500000
thermo_style custom step temp etotal ke pe epair emol press vol
thermo_modify flush yes
run 1000000000
